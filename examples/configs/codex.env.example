# Example environment variables for a local Codex-compatible setup.
# The exact variable names depend on your Codex CLI version.
# Keep the key local and verify the actual model returned by the endpoint.
OPENAI_BASE_URL=https://api.91kun.top/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=replace-with-a-model-id-from-the-current-model-list
